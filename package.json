{
  "name": "finos",
  "private": true,
  "version": "0.1.0",
  "description": "AI-Powered Financial Operating System for SMEs",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @finos/database prisma:generate",
    "db:migrate": "pnpm --filter @finos/database prisma:migrate",
    "db:studio": "pnpm --filter @finos/database prisma:studio"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
